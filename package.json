{
  "name": "amzn-switch",
  "version": "1.4.0",
  "description": "Quick switch between different countries on Amazon website",
  "private": false,
  "scripts": {
    "watch": "webpack --watch",
    "build": "webpack --config webpack-build.config.js",
    "pack": "crx3 dist -o dist/amazon-switch.extension.crx",
    "bump-next-major": "node ./scripts/bump-version.js major next",
    "bump-next-minor": "node ./scripts/bump-version.js minor next",
    "bump-next-patch": "node ./scripts/bump-version.js patch next",
    "bump-release": "node ./scripts/bump-version.js release"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@svgr/webpack": "^8.1.0",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "copy-webpack-plugin": "^14.0.0",
    "crx3": "^2.0.0",
    "css-loader": "^7.1.5",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "semver": "^7.8.5",
    "svg-url-loader": "^8.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3",
    "yargs": "^18.1.0"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "lodash": "^4.18.1",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2"
  }
}
